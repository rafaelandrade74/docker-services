# Porta de acesso ao Vault
VAULT_PORT=8200

# Nível de log (trace, debug, info, warn, error)
VAULT_LOG_LEVEL=info

# Usuário administrador (referência para configuração inicial — não é consumido automaticamente pelo container)
# Utilize estas variáveis como referência ao executar os comandos de configuração inicial manualmente
VAULT_ADMIN_USERNAME=admin
VAULT_ADMIN_PASSWORD=TroqueEstaSenha
